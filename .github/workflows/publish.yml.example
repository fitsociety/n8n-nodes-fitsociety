# Disabled template: configure a public repository, npm trusted publishing
# and a protected npm-release environment before enabling.
name: Publish reviewed package
on:
  workflow_dispatch:
jobs:
  publish:
    runs-on: ubuntu-latest
    environment: npm-release
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          registry-url: https://registry.npmjs.org
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm run lint
      - run: node scripts/release-guard.mjs
      - run: npm publish --provenance --access public
